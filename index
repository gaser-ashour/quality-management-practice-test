<script>

const L=["المحاضرة الأولى: مفهوم الجودة","المحاضرة الثانية: المداخل الأساسية لتعريف الجودة ومراحل تطور إدارة الجودة","المحاضرة الثالثة: أهمية الجودة وأهدافها وتكاليفها"];
// [lecture, question with ___ for the gap, accepted answers separated by |, explanation]
const R=[
[1,"يرجع الأصل اللغوي لكلمة الجودة (Quality) إلى الكلمة اللاتينية ___.","Qualitas|كواليتاس","Qualitas تعني طبيعة الشخص أو الشيء ودرجة صلابته."],
[1,"كان يُقصد بالجودة قديماً الدقة و___.","الإتقان","قديماً كانت الجودة تعني الدقة والإتقان، ثم تغير المفهوم مع الزمن."],
[1,"كلمة Qualitas كانت تُستخدم لوصف ___ أو الخصائص المميزة لشيء أو شخص ما.","الطبيعة","تُستخدم لوصف الطبيعة أو الخصائص المميزة."],
[1,"تغير مفهوم الجودة مع تطور علم الإدارة وظهور الإنتاج الكبير و___ الصناعية.","الثورة","هذه العوامل جعلت وضع معايير ورقابة دقيقة أمراً ضرورياً."],
[1,"بعد ظهور الإنتاج الكبير أصبح من الضروري وضع ___ دقيقة وأساليب رقابة تضمن خروج المنتج بمستوى عالٍ من الإتقان.","معايير","المعايير والرقابة تضمنان خروج المنتج من المصنع بإتقان عالٍ."],
[1,"مع اشتداد المنافسة أصبحت الجودة عنصراً ___ لتحقيق الميزة التنافسية، لا مجرد إتقان للمنتج.","استراتيجياً|استراتيجيا|استراتيجي","تحولت الجودة من إتقان المنتج إلى عنصر استراتيجي للتنافس."],
[1,"من الأبعاد الجديدة للجودة: رضا العملاء والتحسين المستمر وجودة العمليات والخدمات، ومشاركة جميع ___ في الجودة.","العاملين","الجودة مسؤولية كل العاملين وليست مسؤولية قسم واحد."],
[1,"من الخطأ الاعتقاد بأن الجودة العالية تقتصر على الأغلى ثمناً؛ فهي ما يتناسب مع حاجات وتوقعات ___.","العملاء","الجودة تُقاس بمدى مناسبة المنتج لحاجات العملاء وتوقعاتهم لا بسعره."],
[1,"المنتج عالي الجودة يتناسب مع حاجات العميل من حيث الأداء الجيد والتكلفة ___ وتوفره بالكمية المطلوبة في الوقت الملائم.","المناسبة","الجودة ليست أعلى تكلفة، بل تكلفة مناسبة مع أداء جيد وتوافر في الوقت الملائم."],
[1,"عرّف جوران الجودة بأنها ___ للاستخدام (Fitness for use).","الملاءمة|الملائمة|المواءمة","تعريف جوران: الملاءمة للاستخدام أو للغرض."],
[1,"وفق جوران، تعني الملاءمة للاستخدام أن يكون مستخدم السلعة قادراً على ___ عليها في إنجاز ما يريده منها.","الاعتماد","المستخدم يعتمد على السلعة أو الخدمة لإنجاز غرضه."],
[1,"عرّف كروسبي (Crosby) الجودة بأنها المطابقة مع ___.","المتطلبات","تعريف كروسبي: المطابقة مع المتطلبات."],
[1,"العالِم الذي عرّف الجودة بأنها توجه لإشباع حاجات المستهلك في الحاضر والمستقبل هو ___.","ديمينج|ديمنج|Deming","هذا هو تعريف ديمينج."],
[1,"الجودة عند ديمينج ليست حدثاً مؤقتاً بل عملية ___.","مستمرة|مستمره","هي عملية مستمرة تفهم احتياج العميل وتتنبأ بمستقبله."],
[1,"من أهداف الجودة عند ديمينج فهم ما يحتاجه العميل ___ وتلبيته بدقة، والتنبؤ بما سيحتاجه مستقبلاً.","الآن|الان|حالياً|حاليا|حالي|الحالي|في الوقت الحالي|الوقت الحالي","يشمل ديمينج الاحتياج الحالي والمستقبلي معاً."],
[1,"الجودة عند ديمينج فكر استراتيجي طويل ___ قائم على التحسين المستمر والاهتمام الدائم برضا العميل.","المدى","فهي ليست حلاً مؤقتاً بل فكر بعيد المدى."],
[1,"عرّف معهد الجودة الأمريكي الجودة بأنها أداء العمل الصحيح وبالشكل الصحيح من ___ الأولى.","المرة","Do it right the first time."],
[1,"عرّف جونسون الجودة بأنها تحقيق رغبات المستهلك بما يتطابق مع ___ ويحقق رضاه التام.","توقعاته|توقعات","تعريف جونسون يربط الجودة بالتوقعات والرضا التام."],
[1,"ورد تعريف للجودة في المواصفة الدولية الآيزو رقم ___ عبر الجمعية الفرنسية للتقنيين.","9000","الآيزو 9000 تعرّف الجودة بأنها قدرة الخصائص على إرضاء المتطلبات."],
[1,"وفق الآيزو 9000، الجودة هي قدرة مجموعة من الخصائص الجوهرية على إرضاء المتطلبات المعلنة أو ___ لمجموعة من العملاء.","الضمنية|ضمنية","المتطلبات قد تكون معلنة (صريحة) أو ضمنية (كامنة)."],
[1,"تُعرَّف الجودة أيضاً بأنها حالة ___ مرتبطة بالمنتجات والخدمات والأفراد والعمليات والبيئة المحيطة بحيث تتطابق مع التوقعات.","ديناميكية|ديناميكيه","الجودة ليست ثابتة بل حالة ديناميكية متغيرة."],
[1,"من مرتكزات الجودة أنها مفهوم ___ وليس مطلقاً، فهي تعتمد على مدى تلبية المنتج لتوقعات العميل.","نسبي|نسبية|نسبيا","الجودة ليست الأحسن دائماً بشكل مطلق، بل الأحسن بالنسبة للعميل."],
[1,"الجودة لا تعني الأحسن دائماً بشكل مطلق، بل تعني الأحسن ___ للعميل الذي تمت تلبية احتياجاته.","بالنسبة","هذا يوضح نسبية مفهوم الجودة."],
[1,"ارتباط الجودة بالسلعة والأفراد والعمليات وبيئة العمل والإدارة العليا يُعبَّر عنه بمرتكز ___.","الشمولية|شمولية","الجودة لا تقتصر على خصائص السلعة بل تمتد لكل عناصر المؤسسة."],
[1,"تعني الشمولية أن الجودة تمتد لتشمل خصائص المنتج والأفراد والعمليات وبيئة العمل و___ العليا.","الإدارة","الجودة مسؤولية كل عناصر المؤسسة بدءاً من الإدارة العليا."],
[1,"جودة الطعام في المطعم أو جودة الغرفة في الفندق مثال على الشمولية المتعلقة بـ ___ النهائية التي يستلمها العميل.","النتيجة","هذا بُعد النتيجة النهائية التي يستلمها العميل."],
[1,"الاهتمام بتدريب الموظفين ومتابعة آراء النزلاء مثال على وجود تخطيط ورقابة وتبنٍّ لـ ___ الجودة.","ثقافة","يعكس ذلك بُعد التخطيط والرقابة وثقافة الجودة."],
[1,"النظافة والأمان والتنظيم داخل المؤسسة مثال على الشمولية المتعلقة بـ ___ العام داخل المؤسسة.","المناخ","المناخ العام (النظافة، الأمان، التنظيم) جزء من الجودة الشاملة."],
[1,"الجودة حالة ديناميكية تتطور مع تطور توقعات العملاء والمتغيرات البيئية و___.","التكنولوجية|التكنولوجيا","لذلك تحتاج المؤسسات إلى تكييف منتجاتها وخدماتها باستمرار."],
[1,"ليس المهم وجود خصائص جيدة في المنتج بل أن تكون قادرة على ___ احتياجات العملاء فعلياً.","إشباع|اشباع|تلبية|تلبيه|تلبي|التلبية|الإشباع","الجودة تُقاس بقدرة الخصائص على إشباع الاحتياجات فعلياً."],
[2,"من المداخل الأساسية لتعريف الجودة: التفوق والمنتج والمستخدم والتصنيع، ومدخل ___.","القيمة","المداخل الخمسة: التفوق، المنتج، المستخدم، التصنيع، القيمة."],
[2,"يقصد بالجودة وفق مدخل ___ قدرة المنتج على تقديم أفضل أداء وأدق صفات تشبع رغبات المستهلك بغض النظر عن اختلاف الأذواق.","التفوق","هذا تعريف مدخل التفوق (Excellence)."],
[2,"يهتم مدخل التفوق بـ ___ الفعلي للمنتج، ولا يهتم كثيراً بأذواق العملاء أو بالسعر.","الأداء","الجودة فيه = ملاءمة المنتج للاستخدام وأفضل أداء وظيفي."],
[2,"في مدخل المنتج تُعرَّف الجودة بأنها مدى دقة قياس ___ والمواصفات الموجودة في المنتج، مثل المتانة والطعم واللون.","الخصائص","مدخل المنتج يربط الجودة بخصائص المنتج القابلة للقياس."],
[2,"الجودة في مدخل المستخدم مفهوم شخصي ___ تتغير فيه ردود الفعل بحسب المستوى الاجتماعي والثقافي والعوامل الشخصية.","ذاتي|ذاتيا|ذاتيه","الجودة هنا إشباع حاجات وتوقعات المستهلك، وهي ذاتية."],
[2,"التحدي الرئيسي لمدخل المستخدم أن الجودة تصبح مفهوماً ___ يختلف من عميل لآخر، فيصعب إرضاء الجميع بمنتج واحد.","نسبياً|نسبي|نسبيا","تعدد الأذواق والتوقعات يجعل الرضا الكامل لجميع العملاء صعباً."],
[2,"تختار المؤسسة بين استراتيجية تقسيم السوق (Market Segmentation) واستراتيجية السوق ___ (Mass Market).","الكلي|الكلى","استراتيجيتان لمواجهة اختلاف احتياجات العملاء."],
