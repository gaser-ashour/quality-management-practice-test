<style>
:root{--bg:#f4f6fb;--card:#fff;--tx:#14213d;--mut:#5b6478;--bd:#d9deea;--pr:#3b5bdb;--ok:#2b8a3e;--okb:#e6f6ea;--no:#c92a2a;--nob:#fdeaea;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
