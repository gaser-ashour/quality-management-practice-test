.meter{display:flex;align-items:center;gap:10px}
.ring{position:relative;width:64px;height:64px}
.ring svg{width:64px;height:64px;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:6}
.ring .bg{stroke:var(--bd)}.ring .fg{stroke:var(--ok);stroke-linecap:round;transition:stroke-dashoffset .5s}
.ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:.8rem}
.lbl{font-size:.8rem;color:var(--mut)}.big{font-weight:700;font-size:1.05rem}
#wbox{border:1px solid var(--no);background:var(--nob);color:var(--no);border-radius:12px;padding:8px 14px;text-align:center}
