.wr{justify-self:end;display:flex;align-items:center;gap:8px}
#rs{display:inline-flex;align-items:center;gap:5px;font:inherit;font-size:.78rem;line-height:1;color:var(--mut);background:transparent;border:1px solid var(--bd);border-radius:999px;padding:6px 12px;cursor:pointer}
#rs:hover{color:var(--pr);border-color:var(--pr)}
#rs .ic{font-size:1rem}
#wq{flex:none;width:30px;height:30px;border-radius:50%;border:1px solid var(--pr);background:var(--card);color:var(--pr);font:inherit;font-weight:700;font-size:1rem;line-height:1;padding:0;cursor:pointer;text-shadow:0 0 6px var(--pr);animation:glow 2.2s ease-in-out infinite}
@keyframes glow{0%,100%{box-shadow:0 0 3px 0 var(--pr)}50%{box-shadow:0 0 12px 3px var(--pr)}}
#wq:hover{animation-duration:1.1s}
#rs:focus-visible,#wq:focus-visible,.pb:focus-visible{outline:2px solid var(--pr);outline-offset:2px}
@media (prefers-reduced-motion:reduce){#wq{animation:none;box-shadow:0 0 8px 1px var(--pr)}.ov.on .md{animation:none!important}}
@media (max-width:520px){header{padding:8px 10px;gap:6px}.ring,.ring svg{width:52px;height:52px}.lbl{font-size:.72rem}.big{font-size:.95rem}#rs .rl{display:none}#rs{padding:6px 9px}#wbox{padding:5px 8px}#wbox b{font-size:1.1rem}.wr{gap:6px}#wq{width:28px;height:28px}}
main{max-width:760px;margin:0 auto;padding:12px 14px 40px}
h1{font-size:1.25rem;margin:14px 0 4px}
.sep{display:flex;align-items:center;gap:10px;margin:36px 0 16px;color:var(--mut);font-size:.88rem;font-weight:600}.sep::before,.sep::after{content:'';flex:1;border-top:2px dashed var(--bd)}h2{font-size:1.05rem;color:var(--pr);margin:26px 0 8px;border-bottom:2px solid var(--bd);padding-bottom:4px}
.q{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin:12px 0;scroll-margin-top:calc(110px + env(safe-area-inset-top,0px))}
.q.flash{animation:fl 1.6s}@keyframes fl{0%,60%{box-shadow:0 0 0 3px var(--pr)}100%{box-shadow:none}}
.meta{font-size:.78rem;color:var(--mut);margin-bottom:4px}
.qt{font-weight:600;margin-bottom:10px}
.op{display:flex;gap:10px;width:100%;text-align:start;font:inherit;color:var(--tx);background:transparent;border:1px solid var(--bd);border-radius:10px;padding:9px 12px;margin:6px 0;cursor:pointer}
.op:hover:not(:disabled){border-color:var(--pr)}.op:disabled{cursor:default}
.op b{color:var(--pr)}
.op.ok{background:var(--okb);border-color:var(--ok)}.op.no{background:var(--nob);border-color:var(--no)}
.fb{display:none;margin-top:8px;padding:9px 12px;border-radius:10px;font-size:.92rem}
.fb.ok{display:block;background:var(--okb);color:var(--ok)}.fb.no{display:block;background:var(--nob)}
.fb.no strong{color:var(--no)}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
.ov.on{display:flex}
.md{background:var(--card);border-radius:16px;max-width:520px;width:100%;max-height:80vh;overflow:auto;padding:16px;border:1px solid var(--bd)}
.md h3{margin:0 0 10px}.md button.it{display:block;width:100%;text-align:start;font:inherit;color:var(--tx);background:transparent;border:1px solid var(--bd);border-radius:10px;padding:8px 12px;margin:6px 0;cursor:pointer}
.md button.it:hover{border-color:var(--pr)}
.tag{font-size:.75rem;border-radius:8px;padding:1px 8px;margin-inline-end:6px;background:var(--nob);color:var(--no)}.tag.m{background:var(--bd);color:var(--mut)}
.x{float:right;border:0;background:none;color:var(--mut);font-size:1.4rem;cursor:pointer}
.ov.on .md{animation:pop .22s ease-out}@keyframes pop{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:none}}
#rov .md{max-width:400px;text-align:center}
#rsc{font-size:2.6rem;font-weight:800;line-height:1.1;margin-top:6px}
#rpc{color:var(--mut);font-size:.95rem}
#rmsg{font-size:1.2rem;font-weight:700;margin:12px 0 4px}
#rgif{display:block;max-width:100%;max-height:260px;margin:12px auto 0;border-radius:12px}
.pb{margin-top:16px;font:inherit;font-weight:600;color:#fff;background:var(--pr);border:0;border-radius:10px;padding:8px 26px;cursor:pointer}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pb{color:#0f1424}}
:root[data-theme="dark"] .pb{color:#0f1424}
.none{color:var(--mut);margin:18px 0;text-align:center}
.fb .ar{margin-top:6px}
.fi{display:flex;gap:8px;margin-top:6px}.fi input{flex:1;min-width:0;font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:9px 12px}.fi input:focus{outline:2px solid var(--pr);border-color:var(--pr)}.fi input.ok{border-color:var(--ok);background:var(--okb)}.fi input.no{border-color:var(--no);background:var(--nob)}.fi .pb{width:auto;padding:9px 18px}.bl{display:inline-block;min-width:70px;border-bottom:2px solid var(--pr)}.fb .ex{margin-top:6px;color:var(--tx)}
</style>
