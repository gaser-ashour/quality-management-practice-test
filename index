const S=[
 [9,"Seriously, how do you even do that?","gif1.gif"],
 [19,"Is that all you got?","gif2.gif"],
 [29,"We’re getting somewhere","gif3.gif"],
 [39,"Congratulations, I guess","gif4.gif"],
 [49,"Go get ’em, tiger!","gif8.gif"],
 [59,"Keep it up!","gif7.gif"],
 [69,"Now we’re talking","gif6.gif"],
 [79,"Okay, we get it, bookworm","gif5.gif"],
 [89,"Somebody’s on fire!","gif9.gif"],
 [99,"Are you even human?!","gif10.gif"],
 [100,"Phenomenal is an understatement!!","gif11.gif"]
];

const Q=R.map(x=>[x[0]-1,"t",x[1],null,x[2].replace(/^=/,"").split("|"),x[3],x[2][0]==="="]);
const N=Q.length,A=Array(N).fill(null),$=s=>document.querySelector(s),C=2*Math.PI*26;
let tm;
$("#fg").setAttribute("stroke-dasharray",C);
// forgiving normalisation: hamza forms, ى/ي, ة/ه, tatweel, diacritics, spaces, punctuation, leading "ال"
const nz=s=>String(s).toLowerCase().replace(/[\u064B-\u065F\u0670\u0640]/g,"").replace(/[٠-٩]/g,d=>d.charCodeAt(0)-1632).replace(/[۰-۹]/g,d=>d.charCodeAt(0)-1776).replace(/[أإآٱ]/g,"ا").replace(/[ىی]/g,"ي").replace(/ة/g,"ه").replace(/ک/g,"ك").replace(/[ؤئء]/g,"").replace(/[^\u0621-\u064Aa-z0-9]+/g," ").trim().split(" ").map(w=>w.length>4&&w.startsWith("ال")?w.slice(2):w).join("");
const lev=(a,b)=>{let p=[...Array(b.length+1).keys()];for(let i=1;i<=a.length;i++){const c=[i];for(let j=1;j<=b.length;j++)c[j]=Math.min(p[j]+1,c[j-1]+1,p[j-1]+(a[i-1]===b[j-1]?0:1));p=c}return p[b.length]};
const okAns=(v,ans,ex)=>{const y=nz(v);return !!y&&ans.some(a=>{const x=nz(a);if(x===y)return true;if(ex||/\d/.test(x))return false;const t=x.length>=14?2:x.length>=6?1:0;return t>0&&lev(x,y)<=t})};
const esc=t=>String(t).replace(/&/g,"&amp;").replace(/</g,"&lt;");

function render(){
 let h="";
 Q.forEach((q,i)=>{
  if(!i)h+=`<h2>${L[q[0]]}</h2>`;else if(Q[i-1][0]!==q[0])h+=`<div class="sep"><span>الأسئلة التالية من ${L[q[0]]}</span></div>`;
  h+=`<div class="q" id="q${i}"><div class="meta">السؤال ${i+1} من ${N} · أكمل الفراغ</div><div class="qt">${q[2].replace("___",'<span class="bl"></span>')}</div><div class="fi"><input id="in${i}" type="text" dir="rtl" autocomplete="off" placeholder="اكتب إجابتك هنا"><button class="pb ck" type="button" data-i="${i}">تحقق</button></div><div class="fb"></div></div>`;
 });
 $("#qs").innerHTML=h;
}
$("#qs").addEventListener("click",e=>{const b=e.target.closest(".ck");if(b)check(+b.dataset.i)});
$("#qs").addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.matches(".fi input"))check(+e.target.id.slice(2))});

const score=()=>A.filter(a=>a===1).length;
const pct=ok=>!N?0:ok===N?100:Math.min(99,Math.round(ok/N*100));

function check(i){
 if(A[i]!==null)return;
 const q=Q[i],c=$("#q"+i),inp=$("#in"+i),f=c.querySelector(".fb"),v=inp.value;
 if(!v.trim()){inp.focus();return}
 const ok=okAns(v,q[4],q[6]);A[i]=ok?1:0;
 inp.disabled=true;inp.classList.add(ok?"ok":"no");c.querySelector(".ck").disabled=true;
 const shown=q[4][0];
 if(ok){f.className="fb ok";f.innerHTML=`✓ إجابة صحيحة${nz(v)===nz(shown)?"":` — الصيغة المعتمدة: <strong>${esc(shown)}</strong>`}<div class="ex" dir="rtl">${q[5]}</div>`}
 else{f.className="fb no";f.innerHTML=`<strong>✗ إجابة خاطئة.</strong> الإجابة الصحيحة: <strong dir="rtl">${esc(shown)}</strong>${q[4].length>1?` <span class="lbl">(مقبول أيضاً: ${esc(q[4].slice(1).join("، "))})</span>`:""}<div class="ex" dir="rtl">${q[5]}</div>`}
 upd();
 if(A.every(a=>a!==null)){clearTimeout(tm);tm=setTimeout(showResult,800)}
}
function upd(){
 const ok=score(),done=A.filter(a=>a!==null).length;
 $("#sc").textContent=ok+" / "+N;$("#rt").textContent=pct(ok)+"%";
 $("#fg").style.strokeDashoffset=C*(1-(N?ok/N:0));$("#wn").textContent=N-ok;
 $("#st").textContent=done===N?`انتهى الاختبار: نتيجتك ${ok} من ${N}`:`أجبت عن ${done} من ${N}`;
}

// ---------- final result pop-up ----------
const gif=$("#rgif");gif.onerror=()=>{gif.style.display="none"};
function showResult(){
 const ok=score(),p=pct(ok),s=S.find(x=>p<=x[0])||S[S.length-1];
 $("#rsc").textContent=ok+" / "+N;$("#rpc").textContent=p+"%";$("#rmsg").textContent=s[1];
 gif.style.display="";gif.src=s[2];
 $("#rov").classList.add("on");
}

// ---------- wrong answers pop-up (opened by the ? button) ----------
$("#wq").onclick=()=>{
 const l=Q.map((q,i)=>i).filter(i=>A[i]!==1);
 $("#wl").innerHTML=l.length?l.map(i=>`<button class="it" type="button" data-go="${i}"><span class="tag ${A[i]===null?"m":""}">${A[i]===null?"لم تُجَب":"خطأ"}</span>Q${i+1}: <bdi>${Q[i][2].slice(0,70)}${Q[i][2].length>70?"…":""}</bdi></button>`).join(""):"لا توجد أسئلة خاطئة أو لم تُجَب 🎉";
 $("#ov").classList.add("on");
};
const close=()=>document.querySelectorAll(".ov").forEach(o=>o.classList.remove("on"));
$("#cl").onclick=close;$("#rx").onclick=close;$("#rcl").onclick=close;
document.querySelectorAll(".ov").forEach(o=>o.addEventListener("click",e=>{if(e.target===o)close()}));
document.addEventListener("keydown",e=>{if(e.key==="Escape")close()});
$("#wl").addEventListener("click",e=>{
 const b=e.target.closest("[data-go]");if(!b)return;close();
 const c=$("#q"+b.dataset.go);c.scrollIntoView({behavior:"smooth",block:"start"});
 c.classList.remove("flash");void c.offsetWidth;c.classList.add("flash");
});

// ---------- reset ----------
$("#rs").onclick=()=>{
 clearTimeout(tm);close();
 A.fill(null);render();upd();
 window.scrollTo({top:0,behavior:"smooth"});
};

render();upd();
</script>
